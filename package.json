{
  "name": "nutriai-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NutriAI installable PWA with Vercel AI functions.",
  "scripts": {
    "start": "npx serve .",
    "build:scanner": "esbuild scripts/zxing-entry.js --bundle --format=iife --global-name=NutriAIZXing --minify --legal-comments=eof --outfile=vendor/zxing-0.2.1.js",
    "build:pwa": "node scripts/build-pwa.mjs",
    "build": "npm run build:scanner && npm run build:pwa",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --test tests/*.test.js tests/*.test.mjs && node scripts/build-pwa.mjs --check",
    "test:browser": "node tests/pwa-browser.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@zxing/browser": "0.2.1",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "sharp": "0.34.5"
  }
}
